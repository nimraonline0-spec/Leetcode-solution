class Solution:
    def reverse(self, x: int) -> int:
        
        if x < 0 :
            sign = -1
        else:
            sign = 1

        x = abs(x)
        result = 0
        while x > 0:

            digit = x % 10
            x = x // 10
            if result > (2**31 - 1 - digit) // 10:
                return 0

            result = result * 10 + digit

        return sign * result                