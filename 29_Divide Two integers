class Solution:
     def divide(self, dividend: int, divisor: int) -> int:
        negative = (dividend < 0) != (divisor > 0)

        dividend = abs(dividend)
        divisor = abs(divisor)

        quotient = 0

        while dividend >= divisor:
            temp = divisor
            multiple = 1
            
            while dividend >= (temp << 1):
                temp <<= 1
                multiple <<= 1

            dividend -= temp
            quotient += multiple

        if negative:
            quotient = -quotient

        if quotient > 2**31 - 1:
            return 2**31 - 1

        if quotient < -2**31:
            return -2**31

        return quotient